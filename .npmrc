# .npmrc（项目根目录）
registry=https://registry.npmmirror.com/

# 强制 Electron 二进制文件从国内镜像下载
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_mirror:protocol=https
electron_mirror:host=npmmirror.com
electron_mirror:path=/mirrors/electron/

# 禁用 GitHub 相关源（避免 fallback 到国外服务器）
electron_custom_dir={{ version }}
electron_dist_base_url=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
